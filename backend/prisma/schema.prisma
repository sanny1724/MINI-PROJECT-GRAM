// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id               String    @id @default(uuid())
  name             String
  defaultThreshold Int       @default(10)
  createdAt        DateTime  @default(now())
  users            User[]
  products         Product[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Product {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  sku               String
  description       String?
  quantity          Int          @default(0)
  costPrice         Float        @default(0.0)
  sellingPrice      Float        @default(0.0)
  lowStockThreshold Int?         // Custom threshold override for this product. If null, use Organization.defaultThreshold.
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, sku])
}

model State {
  code      Int        @id
  name      String
  districts District[]
}

model District {
  code      Int      @id
  name      String
  nameLocal String?
  stateCode Int
  state     State    @relation(fields: [stateCode], references: [code])
  mandals   Mandal[]
}

model Mandal {
  code         Int       @id
  name         String
  nameLocal    String?
  districtCode Int
  district     District  @relation(fields: [districtCode], references: [code])
  villages     Village[]
}

model Village {
  code       Int       @id
  name       String
  nameLocal  String?
  mandalCode Int
  mandal     Mandal    @relation(fields: [mandalCode], references: [code])
  category   String?
  status     String?

  metrics    VillageMetric?
  officials  VillageOfficial[]
  schemes    VillageScheme[]
  budgets    VillageBudget[]
  grievances VillageGrievance[]
}

model VillageMetric {
  villageCode      Int      @id
  village          Village  @relation(fields: [villageCode], references: [code], onDelete: Cascade)
  developmentScore Int
  riskLevel        String
  waterScore       Int
  waterRisk        String
  waterTrend       String
  educationScore   Int
  educationRisk    String
  educationTrend   String
  healthScore      Int
  healthRisk       String
  healthTrend      String
  agricultureScore Int
  agricultureRisk  String
  agricultureTrend String
  governanceScore  Int
  governanceRisk   String
  governanceTrend  String
  lastUpdated      DateTime @default(now())
}

model VillageOfficial {
  id          String  @id @default(uuid())
  villageCode Int
  village     Village @relation(fields: [villageCode], references: [code], onDelete: Cascade)
  name        String
  designation String
  contact     String
}

model VillageScheme {
  id              String  @id @default(uuid())
  villageCode     Int
  village     Village @relation(fields: [villageCode], references: [code], onDelete: Cascade)
  name            String
  allocatedBudget Float
  spentBudget     Float
  status          String
}

model VillageBudget {
  id                  String  @id @default(uuid())
  villageCode         Int
  village             Village @relation(fields: [villageCode], references: [code], onDelete: Cascade)
  year                String
  totalAllocation     Float
  totalSpent          Float
  infrastructureAlloc Float
  welfareAlloc        Float
}

model VillageGrievance {
  id          String   @id @default(uuid())
  villageCode Int
  village     Village  @relation(fields: [villageCode], references: [code], onDelete: Cascade)
  title       String
  category    String
  status      String
  createdAt   DateTime @default(now())
  description String
}
